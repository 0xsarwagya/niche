  </style>

  <script>
    type Beat = 'music' | 'weather' | 'idle';
    const stage = document.querySelector<HTMLElement>('[data-beat]');
    const sequence: { name: Beat; ms: number }[] = [
      { name: 'music', ms: 5600 },
      { name: 'weather', ms: 3400 },
      { name: 'idle', ms: 1800 },
    ];

    if (stage && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      let index = 0;
      let timer: number | undefined;

      const advance = () => {
        index = (index + 1) % sequence.length;
        stage.dataset.beat = sequence[index].name;
        timer = window.setTimeout(advance, sequence[index].ms);
      };

      const start = () => {
        if (timer) return;
        timer = window.setTimeout(advance, sequence[index].ms);
      };
      const stop = () => {
        window.clearTimeout(timer);
        timer = undefined;
      };

      const io = new IntersectionObserver(
        ([entry]) => (entry.isIntersecting ? start() : stop()),
        { threshold: 0.3 },
      );
      io.observe(stage);
    }

    for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
      button.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(button.dataset.copy ?? '');
          const original = button.textContent;
          button.textContent = 'Copied';
          window.setTimeout(() => (button.textContent = original), 1400);
        } catch {
          /* clipboard unavailable; ignore */
        }
      });
    }
  </script>
